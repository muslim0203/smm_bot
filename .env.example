NODE_ENV="development"
PORT="3000"
BACKEND_URL="http://localhost:3000"
CORS_ORIGINS=""

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smm_bot?schema=public"

# Telegram boshqaruv boti
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ADMIN_USER_IDS=""
TELEGRAM_WEBHOOK_SECRET=""

# Meta / Instagram Professional akkauntlar
INSTAGRAM_AUTOREPLY_ENABLED="false"
INSTAGRAM_DM_AUTOREPLY_ENABLED="true"
INSTAGRAM_COMMENT_AUTOREPLY_ENABLED="true"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_OAUTH_REDIRECT_URI="https://api.example.uz/api/instagram/oauth/callback"
SOCIAL_TOKEN_ENCRYPTION_KEY=""
INSTAGRAM_API_VERSION="v24.0"
INSTAGRAM_GRAPH_BASE_URL="https://graph.instagram.com"
INSTAGRAM_WORKER_INTERVAL_MS="5000"
INSTAGRAM_WORKER_BATCH_SIZE="5"
INSTAGRAM_WORKER_MAX_ATTEMPTS="3"
INSTAGRAM_EVENT_RETENTION_DAYS="90"
SOCIAL_CONTENT_WORKER_INTERVAL_MS="60000"

# Migratsiya davridagi bitta akkaunt rejimi (yangi loyiha uchun shart emas)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""

# OpenAI: javob, ssenariy va rasm generatsiyasi
OPENAI_API_KEY=""
AI_OPENAI_MODEL="gpt-4o-mini"
AI_IMAGE_MODEL="gpt-image-2"
AI_IMAGE_QUALITY="medium"
AI_TIMEOUT_MS="45000"
AI_MAX_OUTPUT_TOKENS="8192"

# Public S3/DO Spaces — Instagram rasmni URL orqali olishi uchun kerak
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_ENDPOINT=""

# Akkauntning loyiha URL'i berilmaganida ishlatiladigan fallback
DEFAULT_WEBSITE_URL=""
